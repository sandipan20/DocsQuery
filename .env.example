# ============================================================
# DocsQuery - Environment Configuration Template
# ============================================================
#
# This file is safe to commit to Git.
#
# For local development:
#
#     cp .env.example .env
#
# Then put your REAL API keys and private values inside .env.
#
# IMPORTANT:
# Never commit .env to Git.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Name of the application.
APP_NAME=DocsQuery

# Current application version.
APP_VERSION=0.1.0

# Enable development/debug behavior.
# Use false in production.
DEBUG=false


# ------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------

# API key for the LLM provider.
#
# Example:
# LLM_API_KEY=your_api_key_here
#
# Leave empty until we configure the LLM.
LLM_API_KEY=

# Name of the LLM model.
#
# Example:
# LLM_MODEL=your-model-name
LLM_MODEL=


# ------------------------------------------------------------
# Qdrant Configuration
# ------------------------------------------------------------

# URL of the Qdrant vector database.
#
# For local development this may eventually be:
# QDRANT_URL=http://localhost:6333
#
# We will configure this when we build vector retrieval.
QDRANT_URL=

# Qdrant API key.
#
# Leave empty when using a local Qdrant instance.
QDRANT_API_KEY=


# ------------------------------------------------------------
# Embedding Model
# ------------------------------------------------------------

# Converts text into numerical vectors for semantic search.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ------------------------------------------------------------
# Cross-Encoder Reranker
# ------------------------------------------------------------

# Used later to rerank the candidates returned by
# hybrid retrieval.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ------------------------------------------------------------
# Retrieval Configuration
# ------------------------------------------------------------

# Number of candidates retrieved from vector search.
TOP_K_DENSE=20

# Number of candidates retrieved from BM25 search.
TOP_K_BM25=20

# Number of candidates kept after cross-encoder reranking.
TOP_K_RERANK=5