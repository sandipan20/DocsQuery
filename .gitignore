# ============================================================
# DocsQuery - Git Ignore Rules
# ============================================================

# ------------------------------------------------------------
# 1. Python Virtual Environment
# ------------------------------------------------------------
# .venv contains the isolated Python environment and all
# installed packages. It should NEVER be committed to Git.
.venv/


# ------------------------------------------------------------
# 2. Python Build / Packaging Files
# ------------------------------------------------------------
# Generated when the project is installed as a Python package.
*.egg-info/

# Python build output
build/
dist/


# ------------------------------------------------------------
# 3. Environment Variables and Secrets
# ------------------------------------------------------------
# .env can contain API keys, passwords, database credentials,
# and other sensitive configuration.
.env


# ------------------------------------------------------------
# 4. Python Cache Files
# ------------------------------------------------------------
# Python creates these automatically when running code.
__pycache__/
*.py[cod]


# ------------------------------------------------------------
# 5. Testing and Coverage
# ------------------------------------------------------------
# Generated by pytest and coverage tools.
.pytest_cache/
.coverage
htmlcov/


# ------------------------------------------------------------
# 6. Jupyter Notebook Temporary Files
# ------------------------------------------------------------
# Jupyter creates checkpoint files automatically.
.ipynb_checkpoints/


# ------------------------------------------------------------
# 7. Project Data
# ------------------------------------------------------------
# Raw and processed datasets may become very large.
# We don't want these files accidentally committed to Git.
data/raw/*
data/processed/*


# ------------------------------------------------------------
# 8. IDE / Editor Files
# ------------------------------------------------------------
# Local editor configuration should not be shared through Git.
.vscode/
.idea/


# ------------------------------------------------------------
# 9. macOS Files
# ------------------------------------------------------------
# macOS automatically creates this file in directories.
.DS_Store


# ------------------------------------------------------------
# 10. Log Files
# ------------------------------------------------------------
# Application and debugging logs should not normally be
# committed to the repository.
*.log